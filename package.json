{
  "name": "glob-sort",
  "version": "1.1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/bvandrc/glob-sort"
  },
  "author": {
    "name": "Blake Vandercar",
    "email": "bvandercar@outlook.com"
  },
  "license": "MIT",
  "type": "module",
  "source": "src/sortedGlob.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "__c0": "====================[ Build & Development ]======================",
    "prepack": "pnpm build",
    "build": "tsup-node",
    "start": "tsup-node --watch",
    "__c1": "====================[ Linting & Type Checking ]==================",
    "check": "npx biome check . && pnpm ts:check",
    "format": "npx biome check . --fix",
    "ts:check": "tsc --noEmit",
    "__c2": "====================[ Unit Testing ]=======================",
    "test": "vitest",
    "test:unit": "pnpm test:coverage",
    "test:watch": "pnpm run test --watch",
    "test:coverage": "pnpm run test --coverage"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@types/mock-fs": "^4",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^4",
    "@vitest/expect": "^4",
    "mock-fs": "^5",
    "tsup": "^8",
    "typescript": "^7",
    "vitest": "^4"
  }
}
